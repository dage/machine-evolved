<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dag.machine-evolved.overnight-supervisor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/dag/projects/Machine-Evolved-overnight-supervisor/scripts/run-overnight-supervisor.sh</string>
    <string>/Users/dag/projects/Machine-Evolved-overnight-supervisor/ops/overnight-supervisor.json</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/dag/projects/Machine-Evolved-overnight-supervisor</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>/Users/dag/projects/Machine-Evolved-overnight-supervisor/training-runs/overnight-supervisor/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/dag/projects/Machine-Evolved-overnight-supervisor/training-runs/overnight-supervisor/launchd.log</string>
</dict>
</plist>
